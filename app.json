{
  "expo": {
    "name": "PULSE // MOBILE",
    "slug": "pulse-mobile",
    "version": "3.0.0",
    "orientation": "default",
    "scheme": "pulse-mobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "PULSE // MOBILE uses Face ID to authorize field operations and encrypted offline storage.",
        "NSCameraUsageDescription": "PULSE // MOBILE uses the camera to scan physical QR checkpoints and capture sealed field evidence photos.",
        "NSPhotoLibraryUsageDescription": "PULSE // MOBILE allows attaching field inspection photos when direct camera hardware is unavailable.",
        "NSLocationWhenInUseUsageDescription": "PULSE // MOBILE captures real GPS coordinates, altitude, and accuracy for field operations."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#09090B"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-camera",
      "expo-location",
      "expo-image-picker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "71c436a1-6032-455d-8c52-59083429e70b"
      }
    },
    "owner": "kievdxd",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71c436a1-6032-455d-8c52-59083429e70b"
    }
  }
}
