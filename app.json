{
  "expo": {
    "name": "PULSE // MOBILE",
    "slug": "pulse-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "pulse-mobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "PULSE // MOBILE uses Face ID to authorize field operations and encrypted offline storage."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
