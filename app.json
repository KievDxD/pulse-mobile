{
  "expo": {
    "name": "PULSE // MOBILE",
    "slug": "pulse-mobile",
    "version": "2.0.0",
    "orientation": "default",
    "scheme": "pulse-mobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090B",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "PULSE // MOBILE uses Face ID to authorize field operations and encrypted offline storage.",
        "NSCameraUsageDescription": "PULSE // MOBILE uses the camera to scan physical QR and barcode checkpoints in the field.",
        "NSLocationWhenInUseUsageDescription": "PULSE // MOBILE captures real GPS coordinates, altitude, and accuracy for field operations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-camera",
      "expo-location",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
